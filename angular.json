{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"insurance-container": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/insurance-container",
			"sourceRoot": "projects/insurance-container/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/insurance-container",
						"index": "projects/insurance-container/src/index.html",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "projects/insurance-container/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/insurance-container/public",
								"output": "."
							}
						],
						"styles": [
							"node_modules/font-awesome/css/font-awesome.min.css",
							"projects/insurance-container/src/styles.scss",
							"node_modules/bootstrap/dist/css/bootstrap.min.css",
							"node_modules/@fortawesome/fontawesome-free/css/all.min.css"
						],
						"scripts": [],
						"main": "projects/insurance-container/src/main.ts",
						"extraWebpackConfig": "projects/insurance-container/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/insurance-container/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "insurance-container:build:production",
							"extraWebpackConfig": "projects/insurance-container/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "insurance-container:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200,
						"publicHost": "http://localhost:4200",
						"extraWebpackConfig": "projects/insurance-container/webpack.config.js",
						"proxyConfig": "proxy.conf.json"
					}
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/insurance-container/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/insurance-container/public"
							}
						],
						"styles": [
							"node_modules/font-awesome/css/font-awesome.min.css",
							"projects/insurance-container/src/styles.scss",
							"node_modules/bootstrap/dist/css/bootstrap.min.css",
							"node_modules/@fortawesome/fontawesome-free/css/all.min.css"
						],
						"scripts": []
					}
				}
			}
		},
